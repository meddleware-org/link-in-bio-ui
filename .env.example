# @meddleware/link-in-bio-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle. None has a default.

# The terms of service (linked from sign-up and the footer).
# VITE_TERMS_URL=https://example.org/terms

# The privacy notice (linked from the footer).
# VITE_PRIVACY_URL=https://example.org/privacy

# Everything else about the deployment (product name, hosts, price, sign-up mode, Sui network) comes from GET /api/v1/instance.
# The API is always same-origin (/api/v1); in `npm run dev` it is proxied to LINK_IN_BIO_API (default http://127.0.0.1:8080).
